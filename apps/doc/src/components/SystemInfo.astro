---
// System information component
const systemInfo = {
  rustVersion: '1.70+',
  bevyVersion: '0.14',
  rapierVersion: '0.23',
  platform: 'Cross-platform',
  lastUpdated: new Date().toLocaleDateString(),
  buildStatus: '✅ Passing'
};
---

<div class="bg-gray-800 rounded-lg p-4 sm:p-6 shadow-lg">
  <h3 class="text-lg sm:text-xl font-bold mb-4 text-orange-400">🖥️ System Information</h3>

  <div class="space-y-2 sm:space-y-3">
    <div class="flex flex-col sm:flex-row sm:justify-between gap-1">
      <span class="text-gray-400 text-sm">Rust Version:</span>
      <span class="font-mono text-green-400 text-sm">{systemInfo.rustVersion}</span>
    </div>

    <div class="flex flex-col sm:flex-row sm:justify-between gap-1">
      <span class="text-gray-400 text-sm">Bevy Version:</span>
      <span class="font-mono text-blue-400 text-sm">{systemInfo.bevyVersion}</span>
    </div>

    <div class="flex flex-col sm:flex-row sm:justify-between gap-1">
      <span class="text-gray-400 text-sm">Rapier Version:</span>
      <span class="font-mono text-purple-400 text-sm">{systemInfo.rapierVersion}</span>
    </div>

    <div class="flex flex-col sm:flex-row sm:justify-between gap-1">
      <span class="text-gray-400 text-sm">Platform:</span>
      <span class="font-mono text-yellow-400 text-sm">{systemInfo.platform}</span>
    </div>

    <div class="flex flex-col sm:flex-row sm:justify-between gap-1">
      <span class="text-gray-400 text-sm">Last Updated:</span>
      <span class="font-mono text-cyan-400 text-sm">{systemInfo.lastUpdated}</span>
    </div>

    <div class="flex flex-col sm:flex-row sm:justify-between gap-1">
      <span class="text-gray-400 text-sm">Build Status:</span>
      <span class="font-mono text-sm">{systemInfo.buildStatus}</span>
    </div>
  </div>

  <div class="mt-4 sm:mt-6">
    <h4 class="text-base sm:text-lg font-semibold mb-2">Performance Targets</h4>
    <div class="space-y-1 text-xs sm:text-sm">
      <div class="flex flex-col sm:flex-row sm:justify-between gap-1">
        <span>Scene Parsing (500 nodes):</span>
        <span class="text-green-400 font-mono">≤ 5ms</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:justify-between gap-1">
        <span>SceneGraph Loading (500 nodes):</span>
        <span class="text-green-400 font-mono">≤ 3ms</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:justify-between gap-1">
        <span>Physics Simulation (100 steps):</span>
        <span class="text-green-400 font-mono">≤ 1ms</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:justify-between gap-1">
        <span>Memory Usage:</span>
        <span class="text-green-400 font-mono">≤ 50MB</span>
      </div>
    </div>
  </div>
</div>
