---
// System information component
const systemInfo = {
  rustVersion: '1.70+',
  bevyVersion: '0.14',
  rapierVersion: '0.23',
  platform: 'Cross-platform',
  lastUpdated: new Date().toLocaleDateString(),
  buildStatus: '✅ Passing'
};
---

<div class="bg-gray-800 rounded-lg p-6 shadow-lg">
  <h3 class="text-xl font-bold mb-4 text-orange-400">🖥️ System Information</h3>

  <div class="space-y-3">
    <div class="flex justify-between">
      <span class="text-gray-400">Rust Version:</span>
      <span class="font-mono text-green-400">{systemInfo.rustVersion}</span>
    </div>

    <div class="flex justify-between">
      <span class="text-gray-400">Bevy Version:</span>
      <span class="font-mono text-blue-400">{systemInfo.bevyVersion}</span>
    </div>

    <div class="flex justify-between">
      <span class="text-gray-400">Rapier Version:</span>
      <span class="font-mono text-purple-400">{systemInfo.rapierVersion}</span>
    </div>

    <div class="flex justify-between">
      <span class="text-gray-400">Platform:</span>
      <span class="font-mono text-yellow-400">{systemInfo.platform}</span>
    </div>

    <div class="flex justify-between">
      <span class="text-gray-400">Last Updated:</span>
      <span class="font-mono text-cyan-400">{systemInfo.lastUpdated}</span>
    </div>

    <div class="flex justify-between">
      <span class="text-gray-400">Build Status:</span>
      <span class="font-mono">{systemInfo.buildStatus}</span>
    </div>
  </div>

  <div class="mt-6">
    <h4 class="text-lg font-semibold mb-2">Performance Targets</h4>
    <div class="space-y-1 text-sm">
      <div class="flex justify-between">
        <span>Scene Parsing (500 nodes):</span>
        <span class="text-green-400">≤ 5ms</span>
      </div>
      <div class="flex justify-between">
        <span>SceneGraph Loading (500 nodes):</span>
        <span class="text-green-400">≤ 3ms</span>
      </div>
      <div class="flex justify-between">
        <span>Physics Simulation (100 steps):</span>
        <span class="text-green-400">≤ 1ms</span>
      </div>
      <div class="flex justify-between">
        <span>Memory Usage:</span>
        <span class="text-green-400">≤ 50MB</span>
      </div>
    </div>
  </div>
</div>
