---
import PerformanceCharts from './PerformanceCharts.tsx';
import BenchmarkSummary from './BenchmarkSummary.tsx';
import SystemInfo from './SystemInfo.astro';

// Load performance data (mock data for build time)
const apiData = {
  benchmarks: [
    {
      name: 'scene_parsing',
      measurements: [
        { name: 'parse_10_nodes', value: 0.15, unit: 'ms', sample_size: 100 },
        { name: 'parse_50_nodes', value: 0.45, unit: 'ms', sample_size: 100 },
        { name: 'parse_100_nodes', value: 0.85, unit: 'ms', sample_size: 100 },
        { name: 'parse_500_nodes', value: 3.2, unit: 'ms', sample_size: 100 }
      ]
    },
    {
      name: 'scene_graph_loading',
      measurements: [
        { name: 'load_10_nodes', value: 0.12, unit: 'ms', sample_size: 100 },
        { name: 'load_50_nodes', value: 0.38, unit: 'ms', sample_size: 100 },
        { name: 'load_100_nodes', value: 0.72, unit: 'ms', sample_size: 100 },
        { name: 'load_500_nodes', value: 2.8, unit: 'ms', sample_size: 100 }
      ]
    },
    {
      name: 'physics_simulation',
      measurements: [
        { name: 'physics_10_steps', value: 0.08, unit: 'ms', sample_size: 50 },
        { name: 'physics_50_steps', value: 0.35, unit: 'ms', sample_size: 50 },
        { name: 'physics_100_steps', value: 0.68, unit: 'ms', sample_size: 50 }
      ]
    }
  ]
};

// Process API data into chart format
const performanceData = processApiData(apiData);

function processApiData(apiData: any) {
  const result = {
    sceneParsing: { name: 'Scene Parsing', data: [] as any[] },
    sceneGraph: { name: 'SceneGraph Loading', data: [] as any[] },
    physics: { name: 'Physics Simulation', data: [] as any[] }
  };

  if (apiData.benchmarks) {
    apiData.benchmarks.forEach((benchmark: any) => {
      if (benchmark.measurements) {
        benchmark.measurements.forEach((measurement: any) => {
          if (measurement.name.includes('parse_')) {
            const nodes = parseInt(measurement.name.replace('parse_', '').replace('_nodes', ''));
            result.sceneParsing.data.push({
              nodes,
              time: measurement.value
            });
          } else if (measurement.name.includes('load_')) {
            const nodes = parseInt(measurement.name.replace('load_', '').replace('_nodes', ''));
            result.sceneGraph.data.push({
              nodes,
              time: measurement.value
            });
          } else if (measurement.name.includes('physics_')) {
            const steps = parseInt(measurement.name.replace('physics_', '').replace('_steps', ''));
            result.physics.data.push({
              steps,
              time: measurement.value
            });
          }
        });
      }
    });
  }

  // Sort data by size
  result.sceneParsing.data.sort((a, b) => a.nodes - b.nodes);
  result.sceneGraph.data.sort((a, b) => a.nodes - b.nodes);
  result.physics.data.sort((a, b) => a.steps - b.steps);

  return result;
}
---

<div class="grid grid-cols-1 xl:grid-cols-3 gap-4 sm:gap-6 lg:gap-8 mb-6 sm:mb-8">
  <div class="xl:col-span-2 order-2 xl:order-1">
    <div class="bg-gray-800 rounded-lg p-4 sm:p-6 shadow-lg">
      <h2 class="text-xl sm:text-2xl font-bold mb-4 text-blue-400">📊 Performance Overview</h2>
      <PerformanceCharts
        client:load
        sceneParsing={performanceData.sceneParsing}
        sceneGraph={performanceData.sceneGraph}
        physics={performanceData.physics}
      />
    </div>
  </div>

  <div class="order-1 xl:order-2">
    <SystemInfo />
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6 lg:gap-8">
  <div class="bg-gray-800 rounded-lg p-4 sm:p-6 shadow-lg">
    <h3 class="text-lg sm:text-xl font-bold mb-4 text-green-400">🎯 Benchmark Summary</h3>
    <BenchmarkSummary
      client:load
      data={performanceData}
    />
  </div>

  <div class="bg-gray-800 rounded-lg p-4 sm:p-6 shadow-lg">
    <h3 class="text-lg sm:text-xl font-bold mb-4 text-purple-400">🔍 Recent Benchmarks</h3>
    <div class="space-y-3">
      <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center p-3 bg-gray-700 rounded gap-2">
        <span class="text-sm sm:text-base">Scene Parsing (500 nodes)</span>
        <span class="text-green-400 font-mono text-sm">3.2ms</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center p-3 bg-gray-700 rounded gap-2">
        <span class="text-sm sm:text-base">SceneGraph Loading (500 nodes)</span>
        <span class="text-yellow-400 font-mono text-sm">2.8ms</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center p-3 bg-gray-700 rounded gap-2">
        <span class="text-sm sm:text-base">Physics Simulation (100 steps)</span>
        <span class="text-blue-400 font-mono text-sm">0.68ms</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center p-3 bg-gray-700 rounded gap-2">
        <span class="text-sm sm:text-base">Topology Updates (200 nodes)</span>
        <span class="text-purple-400 font-mono text-sm">0.8ms</span>
      </div>
    </div>
  </div>
</div>

<div class="mt-6 sm:mt-8 bg-gray-800 rounded-lg p-4 sm:p-6 shadow-lg">
  <h3 class="text-lg sm:text-xl font-bold mb-4 text-red-400">⚡ Performance Trends</h3>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <div class="text-center p-4 bg-gray-700 rounded-lg">
      <div class="text-2xl sm:text-3xl font-bold text-green-400 mb-2">↗️ +2.3%</div>
      <div class="text-xs sm:text-sm text-gray-400">Parsing Performance</div>
    </div>
    <div class="text-center p-4 bg-gray-700 rounded-lg">
      <div class="text-2xl sm:text-3xl font-bold text-yellow-400 mb-2">→ 0.0%</div>
      <div class="text-xs sm:text-sm text-gray-400">Memory Usage</div>
    </div>
    <div class="text-center p-4 bg-gray-700 rounded-lg sm:col-span-2 lg:col-span-1">
      <div class="text-2xl sm:text-3xl font-bold text-blue-400 mb-2">↘️ -1.8%</div>
      <div class="text-xs sm:text-sm text-gray-400">Physics Simulation</div>
    </div>
  </div>
</div>
